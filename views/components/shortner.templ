package components

import "github.com/Francesco99975/urx/views/icons"
import "github.com/Francesco99975/urx/views/ui"

templ ShortenerForm() {
	<div
		id="shortener-form"
		class="max-w-2xl mx-auto"
		x-data="{
          url: ''
        }"
	>
		<form
			hx-post="/shorten"
			hx-target="#shortener-result"
			hx-swap="innerHTML"
			{ ui.WithLoading("shorten-loading")... }
			class="flex flex-col sm:flex-row gap-3"
		>
			<div class="flex-1 relative">
				<input
					type="url"
					id="url"
					name="url"
					x-model="url"
					placeholder="Paste your long URL here..."
					required
					autocomplete="url"
					class="w-full px-4 py-3.5 md:py-4 text-base md:text-lg border-2 border-gray-200 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white dark:bg-black"
				/>
			</div>
			@ui.SubmitButton("shorten-loading") {
				<span>Shorten</span>
			}
		</form>
		<div id="shortener-result"></div>
	</div>
}

templ ShortenedResult(shortenedURL string) {
	<div
		x-data="{ copied: false }"
		class="mt-6 p-4 md:p-6 bg-white rounded-2xl border-2 border-green-200 shadow-lg animate-fade-in"
	>
		<p class="text-sm text-gray-500 mb-2">Your shortened URL is ready!</p>
		<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
			<div class="flex-1 px-4 py-3 bg-gray-50 rounded-lg text-left overflow-x-auto">
				<a
					href={ templ.SafeURL(shortenedURL) }
					target="_blank"
					rel="noopener noreferrer"
					class="text-primary font-medium hover:underline break-all"
				>
					{ shortenedURL }
				</a>
			</div>
			<button
				type="button"
				@click={ "navigator.clipboard.writeText('" + shortenedURL + "'); copied = true; setTimeout(() => copied = false, 2000)" }
				class="px-4 py-3 rounded-lg font-medium transition-all flex items-center justify-center gap-2"
				:class="copied ? 'bg-green-500 text-white' : 'bg-gray-100 hover:bg-gray-200 text-gray-700'"
			>
				<template x-if="!copied">
					@icons.Copy("w-5 h-5")
				</template>
				<template x-if="copied">
					@icons.Check("w-5 h-5")
				</template>
				<span x-text="copied ? 'Copied!' : 'Copy'"></span>
			</button>
		</div>
	</div>
}
