package components

import "github.com/Francesco99975/urx/views/icons"
import "github.com/Francesco99975/urx/views/ui"
import "strings"

templ ShortenerForm(csrf string) {
	<div
		id="shortener-form"
		class="max-w-2xl mx-auto"
		x-data="{
          url: ''
        }"
	>
		<form
			hx-post="/shorten"
			hx-target="#shortener-result"
			hx-swap="innerHTML"
			{ ui.WithLoading("shorten-loading")... }
			class="flex flex-col sm:flex-row gap-3"
		>
			@CSRF(csrf)
			<div class="flex-1 relative">
				<input
					type="url"
					id="url"
					name="url"
					x-model="url"
					placeholder="Paste your long URL here..."
					required
					autocomplete="url"
					class="w-full px-4 py-3.5 md:py-4 text-base md:text-lg border-2 border-gray-200 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white dark:bg-black dark:text-white"
				/>
			</div>
			@ui.SubmitButton("shorten-loading") {
				<span>Shorten</span>
			}
		</form>
		<div id="shortener-result"></div>
	</div>
}

templ ShortenedResult(shortenedURL string, qrCode string) {
	<div
		x-data="{ copied: false }"
		class="mt-6 p-4 md:p-6 bg-white dark:bg-gray-800 rounded-2xl border border-primary/20 shadow-xl animate-fade-in"
	>
		<!-- Header -->
		<div class="flex items-center gap-2 mb-4">
			<div class="w-8 h-8 rounded-full bg-success/20 flex items-center justify-center">
				@icons.Check("w-4 h-4 text-success")
			</div>
			<p class="text-sm font-medium text-gray-700 dark:text-gray-300">Your shortened URL is ready!</p>
		</div>
		<!-- Main Content Grid -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
			<!-- Left: URL and Copy -->
			<div class="flex flex-col gap-3">
				<label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Short Link</label>
				<div class="flex items-center gap-2 p-3 bg-gray-50 dark:bg-gray-700 rounded-xl border border-gray-200 dark:border-gray-600">
					<a
						href={ templ.SafeURL(shortenedURL) }
						target="_blank"
						rel="noopener noreferrer"
						class="flex-1 text-primary font-semibold hover:underline break-all text-sm md:text-base"
					>
						{ strings.TrimPrefix(shortenedURL, "https://") }
					</a>
				</div>
				<button
					type="button"
					@click={ "navigator.clipboard.writeText('" + shortenedURL + "'); copied = true; setTimeout(() => copied = false, 2000)" }
					class="w-full px-4 py-3 rounded-xl font-medium transition-all flex items-center justify-center gap-2 cursor-pointer"
					:class="copied ? 'bg-success text-white' : 'bg-primary text-white hover:bg-primary/90'"
				>
					<template x-if="!copied">
						@icons.Copy("w-5 h-5")
					</template>
					<template x-if="copied">
						@icons.Check("w-5 h-5")
					</template>
					<span x-text="copied ? 'Copied!' : 'Copy Link'"></span>
				</button>
			</div>
			<!-- Right: QR Code -->
			<div class="flex flex-col items-center gap-3">
				<label class="text-xs font-medium text-gray-500 uppercase tracking-wide self-start md:self-center">QR Code</label>
				<div class="p-3 bg-white rounded-xl shadow-sm border border-gray-100">
					<img id="qr-code-img" src={ qrCode } alt="QR Code for shortened URL" class="w-32 h-32 sm:w-40 sm:h-40"/>
				</div>
				<a
					:href={ "'" + qrCode + "'" }
					download="qrcode.png"
					class="w-full md:w-auto px-4 py-2.5 rounded-xl font-medium transition-all flex items-center justify-center gap-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-600 cursor-pointer text-sm"
				>
					@icons.Download("w-4 h-4")
					<span>Download QR</span>
				</a>
			</div>
		</div>
	</div>
}

// ShortenedError is returned by the server via HTMX when shortening fails
templ ShortenedError(errorMsg string) {
	<div class="mt-6 p-4 md:p-6 bg-white dark:bg-gray-800 rounded-2xl border-2 border-error/30 shadow-lg animate-fade-in">
		<p class="text-sm text-error font-medium mb-1">Something went wrong</p>
		<p class="text-sm text-gray-600 dark:text-gray-400">{ errorMsg }</p>
		<button
			type="button"
			hx-get="/shorten"
			hx-target="#shortener-form"
			hx-swap="outerHTML"
			class="mt-4 text-sm text-gray-500 hover:text-primary transition-colors cursor-pointer"
		>
			&larr; Try again
		</button>
	</div>
}
