package components

import "fmt"

// Mobile card view for activity
templ ActivityCard(time, shortURL, device, referrer string, isDirect bool) {
	<div class="p-4">
		<div class="flex items-start justify-between mb-2">
			<span class="text-xs text-gray-400">{ time }</span>
			<span class="px-2 py-0.5 bg-primary/10 text-primary text-xs font-medium rounded-full">{ shortURL }</span>
		</div>
		<p class="text-sm text-primary mb-1">{ device }</p>
		if isDirect {
			<p class="text-xs text-purple-800 italic">Direct</p>
		} else {
			<p class="text-xs text-accent truncate">{ referrer }</p>
		}
	</div>
}

// Desktop table row for activity
templ ActivityTableRow(time, shortURL, statsURL, device, referrer string, isDirect bool) {
	<tr class="hover:bg-accent/20 transition-colors">
		<td class="px-6 py-4 text-sm text-primary/70 whitespace-nowrap">{ time }</td>
		<td class="px-6 py-4">
			<a href={ templ.SafeURL(statsURL) } class="text-sm font-medium text-primary hover:underline">{ shortURL }</a>
		</td>
		<td class="px-6 py-4 text-sm text-primary">{ device }</td>
		if isDirect {
			<td class="px-6 py-4 text-sm text-purple-800 italic">Direct</td>
		} else {
			<td class="px-6 py-4 text-sm text-accent truncate max-w-xs">{ referrer }</td>
		}
	</tr>
}

templ DeviceItem(name, percent string, percentInt int) {
	<div class="flex items-center gap-3">
		<div class="w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center shrink-0">
			{ children... }
		</div>
		<div class="flex-1 min-w-0">
			<p class="text-sm font-medium text-gray-900">{ name }</p>
			@ProgressBar(percentInt, "bg-accent")
		</div>
		<span class="text-sm font-semibold text-gray-700 shrink-0">{ percent }</span>
	</div>
}

templ BrowserChip(label string) {
	<span class="px-2.5 py-1 bg-primary/10 text-accent text-xs rounded-full">{ label }</span>
}

templ ProgressBar(percent int, colorClass string) {
	<div class="w-full bg-gray-500 rounded-full h-1.5 mt-1">
		<div class={ "h-1.5 rounded-full", colorClass } style={ fmt.Sprintf("width: %d%%", percent) }></div>
	</div>
}

templ ReferrerItem(name, count string, percent int) {
	<div class="flex items-center gap-3">
		<div class="w-8 h-8 rounded-lg bg-gray-100 flex items-center justify-center shrink-0">
			{ children... }
		</div>
		<div class="flex-1 min-w-0">
			<p class="text-sm font-medium text-gray-900 truncate">{ name }</p>
			@ProgressBar(percent, "bg-primary")
		</div>
		<span class="text-sm font-semibold text-gray-700 shrink-0">{ count }</span>
	</div>
}

templ ReferrerBadge(letter, bgClass, textClass string) {
	<div class={ "w-8 h-8 rounded-lg flex items-center justify-center shrink-0", bgClass }>
		<span class={ "text-xs font-bold", textClass }>{ letter }</span>
	</div>
}

templ StatsCard(value, label, iconBgClass string) {
	<div class="bg-std rounded-xl border border-accent p-4 md:p-5">
		<div class="flex items-center gap-3 mb-3">
			<div class={ "w-9 h-9 md:w-10 md:h-10 rounded-lg flex items-center justify-center", iconBgClass }>
				{ children... }
			</div>
		</div>
		<p class="text-2xl md:text-3xl font-bold text-primary">{ value }</p>
		<p class="text-xs md:text-sm text-accent">{ label }</p>
	</div>
}

templ TopLinkItem(rank int, shortURL, originalURL, statsURL, clicks, trend, trendClass string) {
	<a href={ templ.SafeURL(statsURL) } class="flex items-center gap-3 p-3 rounded-lg hover:bg-std/70 transition-colors group">
		<div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0 text-sm font-bold text-primary">
			{ fmt.Sprintf("%d", rank) }
		</div>
		<div class="flex-1 min-w-0">
			<p class="text-sm font-medium text-primary group-hover:text-accent transition-colors">{ shortURL }</p>
			<p class="text-xs text-primary/70 truncate">{ originalURL }</p>
		</div>
		<div class="text-right shrink-0">
			<p class="text-sm font-semibold text-primary">{ clicks }</p>
			<p class={ "text-xs", trendClass }>{ trend }</p>
		</div>
	</a>
}
